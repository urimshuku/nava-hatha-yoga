# Public site URL (used for SEO canonical URLs, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://navahathayoga.com

# Resend form notification delivery (server-only)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Nava Hatha Yoga <info@navahathayoga.com>"
FORM_NOTIFICATION_EMAIL=info@navahathayoga.com

# Built-in CMS (/login). Server-only — never prefix these with NEXT_PUBLIC_.
# CMS_PASSWORD is the single shared password given to the site owner.
# CMS_SESSION_SECRET signs the login cookie; use a long random string.
# In production set both with: npx wrangler secret put CMS_PASSWORD
CMS_PASSWORD=
CMS_SESSION_SECRET=
